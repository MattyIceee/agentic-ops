# ops-agent environment configuration — copy to .env and fill in real values

# --- LLM endpoint (OpenAI-compatible) ---
# Any OpenAI-compatible /v1 server works: llama.cpp, vLLM, Ollama, LM Studio,
# OpenRouter, Groq, DeepSeek, ... To switch providers just change these three
# values (host, key, model) — nothing else in the repo needs editing.

# Provider profile:
#   "llamacpp"          -> also sends llama.cpp/Qwen3 extensions (top_k, thinking)
#   "openai-compatible" -> standard OpenAI params only
LLM_PROVIDER=llamacpp

# Base URL of the OpenAI-compatible API endpoint
LLM_BASE_URL=http://localhost/v1

# API key — llama.cpp ignores auth but the client requires a non-empty value;
# cloud providers need a real key
LLM_API_KEY=sk-no-auth

# Model name as served by the endpoint
LLM_MODEL=qwen3.6-a3b

# Base URL of your SearXNG instance (required)
# Defaults to the docker-compose.yml searxng service (host port 8081)
SEARXNG_URL=http://localhost:8081

# GitHub fine-grained personal access token (required)
# Repository permissions needed: Contents read/write, Pull requests read/write,
# Issues read/write, Metadata read
GITHUB_TOKEN=github_pat_...

# GitHub API host — override only for GitHub Enterprise Server (https://<host>/api/v3/)
GITHUB_API_BASE_URL=https://api.github.com/

# GitHub git clone host — override only for GitHub Enterprise Server
GITHUB_BASE_URL=https://github.com

# Git commit author identity used when the agent commits files
GIT_AUTHOR_NAME=ops-agent
GIT_AUTHOR_EMAIL=ops-agent@homelab.local

# Base directory where the agent clones and manages repos.
# The default /data/repos is container-friendly; on Windows set an absolute local path.
REPO_LOCATION=/data/repos

# Timeout in seconds for outbound HTTP requests (llama.cpp, SearXNG, GitHub, fetch)
REQUEST_TIMEOUT_SECONDS=120

# Checkpointing configuration (PostgreSQL) — optional, enables resumable graph runs
CHECKPOINT_ENABLED=true
CHECKPOINT_DB_HOST=localhost
CHECKPOINT_DB_PORT=5432
CHECKPOINT_DB_USER=ops_agent
CHECKPOINT_DB_PASSWORD=ops_agent_dev_password
CHECKPOINT_DB_NAME=ops_agent_checkpoints

# Langfuse tracing (optional) — enables distributed tracing of graph executions
LANGFUSE_ENABLED=false
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_BASE_URL=http://localhost:3000

# LangSmith tracing (optional) — an alternative/additional tracer to Langfuse.
# Unlike Langfuse (which ops-agent wires up explicitly in tracing.py), LangSmith
# is picked up automatically by LangChain/LangGraph's global callback manager —
# just set these env vars, no code changes required. Every graph run gets traced
# to the given project as long as LANGSMITH_TRACING=true.
# Get an API key at https://smith.langchain.com/ (Settings -> API Keys).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=ops-agent
