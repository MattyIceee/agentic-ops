# ops-agent environment configuration — copy to .env and fill in real values

# Base URL of the llama.cpp OpenAI-compatible endpoint
LLAMACPP_BASE_URL=http://localhost:8080/v1

# Model alias registered in llama.cpp (do not change unless you re-register the model)
MODEL_ALIAS=qwen3.6-a3b

# Placeholder API key — llama.cpp ignores auth but the OpenAI client requires a non-empty value
LLAMACPP_API_KEY=sk-no-auth

# Base URL of your self-hosted SearXNG instance (required)
SEARXNG_URL=http://searxng.homelab.local

# Base URL of your Gitea instance, no trailing slash (required)
GITEA_BASE_URL=https://gitea.homelab.local

# Gitea personal access token with repo read/write scope (required)
GITEA_TOKEN=your-gitea-pat-here

# Git commit author identity used when the agent commits files
GIT_AUTHOR_NAME=ops-agent
GIT_AUTHOR_EMAIL=ops-agent@homelab.local

# Absolute path to a local repo that Graph B reads to learn Kustomize/Flux conventions (optional)
EXAMPLE_REPO_PATH=

# Timeout in seconds for outbound HTTP requests (llama.cpp, SearXNG, Gitea, fetch)
REQUEST_TIMEOUT_SECONDS=120

# Checkpointing configuration (PostgreSQL) — optional, enables resumable graph runs
CHECKPOINT_ENABLED=true
CHECKPOINT_DB_HOST=localhost
CHECKPOINT_DB_PORT=5432
CHECKPOINT_DB_USER=ops_agent
CHECKPOINT_DB_PASSWORD=ops_agent_dev_password
CHECKPOINT_DB_NAME=ops_agent_checkpoints

# Langfuse tracing (optional) — enables distributed tracing of graph executions
LANGFUSE_ENABLED=false
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_BASE_URL=http://localhost:3000
